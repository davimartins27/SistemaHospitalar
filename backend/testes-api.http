@baseUrl = http://localhost:8080

### Cadastrar paciente
POST {{baseUrl}}/pacientes
Content-Type: application/json

{
  "nome": "Mariana Souza",
  "cpf": "12345678900",
  "dataNascimento": "1998-05-10",
  "telefone": "31999990000",
  "endereco": "Rua Central, 100",
  "email": "mariana@email.com"
}

### Cadastrar médico clínico geral
POST {{baseUrl}}/profissionais
Content-Type: application/json

{
  "categoria": "CLINICO_GERAL",
  "nome": "Lucas Vieira",
  "registroProfissional": "CRM10001",
  "telefone": "31988887777",
  "email": "lucas@email.com"
}

### Cadastrar médico especialista
POST {{baseUrl}}/profissionais
Content-Type: application/json

{
  "categoria": "ESPECIALISTA",
  "nome": "Ana Costa",
  "registroProfissional": "CRM10002",
  "telefone": "31988886666",
  "email": "ana@email.com",
  "especialidade": "Cardiologia"
}

### Cadastrar cirurgião
POST {{baseUrl}}/profissionais
Content-Type: application/json

{
  "categoria": "CIRURGIAO",
  "nome": "Rafael Lima",
  "registroProfissional": "CRM10003",
  "telefone": "31988885555",
